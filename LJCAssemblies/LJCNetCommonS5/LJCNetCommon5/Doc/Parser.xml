  </BeginIndex>
  <BeginIndex>
    The delimited string end index.
  </BeginIndex>
  <StartIndex>
    The parsing start index.
  </StartIndex>
  
  <!-- Constructors -->
  <Constructor>
    <summary>
      Initializes an object instance.
    </summary>
  </Constructor>
  
