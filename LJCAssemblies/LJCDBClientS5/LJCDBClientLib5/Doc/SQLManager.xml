<!-- SQLManager.xml -->
<members>
  <!-- Class -->
  <LJCSQLManager>
    <summary>
      Provides SQL data manipulation methods.
    </summary>
  </LJCSQLManager>
  
  <!-- Properties -->
  <AffectedCount>
    <summary>
      Gets or sets the non-select affected record count.
    </summary>
  </AffectedCount>
  <BaseDefinition>
    <summary>
      Gets the base data definition columns collection.
    </summary>
  </BaseDefinition>
  <DataConfigName>
    <summary>
      Gets or sets the data configuration name.
    </summary>
  </DataConfigName>
  <DataDefinition>
    <summary>
      Gets the data definition columns collection.
    </summary>
  </DataDefinition>
  <DbAssignedColumns>
    <summary>
      Gets or sets the Database assigned columns.
    </summary>
  </DbAssignedColumns>
  <SchemaName>
    <summary>
      The Schema name.
    </summary>
  </SchemaName>
  <SQLStatement>
    <summary>
      Gets or sets the last SQL statement.
    </summary>
  </SQLStatement>
  <TableName>
    <summary>
      The primary table name.
    </summary>
  </TableName>

  <!-- Constructor Methods -->
  <Constructor>
    <summary>
      Initializes an object instance with the supplied values.
    </summary>
    <param name="dataConfigName"></param>
    <param name="tableName"></param>
    <param name="connectionString"></param>
    <param name="providerName"></param>
  </Constructor>
  <Reset>
    <summary>
      Resets the data access configuration.
    </summary>
    <param name="dataConfigName"></param>
    <param name="tableName"></param>
    <param name="connectionString"></param>
    <param name="providerName"></param>
  </Reset>
  
  <!-- Public Data Methods -->
  <Add>
    <summary>
      Adds a record to the database.
    </summary>
    <param name="dataObject"></param>
    <param name="propertyNames"></param>
    <returns></returns>
  </Add>
  <Delete>
    <summary>
      Deletes the records with the specified key values.
    </summary>
    <param name="keyColumns"></param>
    <param name="filters"></param>
  </Delete>
  <Load>
    <summary>
      Gets a DataTable object.
    </summary>
    <param name="keyColumns"></param>
    <param name="propertyNames"></param>
    <param name="filters"></param>
    <param name="joins"></param>
    <returns></returns>
  </Load>
  <Update>
    <summary>
      Gets a DataTable object.
    </summary>
    <param name="dataObject"></param>
    <param name="keyColumns"></param>
    <param name="propertyNames"></param>
    <param name="filters"></param>
    <returns></returns>
  </Update>
  <MapNames>
    <summary>
      Maps the column property and rename values.
    </summary>
    <param name="columnName"></param>
    <param name="propertyName"></param>
    <param name="renameAs"></param>
    <param name="caption"></param>
  </MapNames>
  <SetLookupColumns>
    <summary>
      Adds the lookup column names.
    </summary>
    <param name="propertyNames"></param>
  </SetLookupColumns>
</members>