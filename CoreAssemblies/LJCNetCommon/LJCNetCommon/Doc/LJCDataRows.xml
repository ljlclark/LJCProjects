<!-- LJCDataRows.xml -->
<members>
  <!-- Class -->
  <LJCDataRows>
    <summary>
      Represents a collection of
      &lt;span class="userType"&gt;DbColumn&lt;/span&gt; objects.
    </summary>
    <remarks>
      A DbColumn collection element can also be retrieved by name using
      the collection object: columns["ColumnName"];
    </remarks>
  </LJCDataRows>

  <!-- Properties -->
  <LJCKeys>
    <summary>
      Gets or sets the key columns.
    </summary>
  </LJCKeys>
  
  <!-- Constructor Methods -->
  <Constructor>
    <summary>
      Initializes an object instance.
    </summary>
  </Constructor>
  <CopyConstructor>
    <summary>
      Initializes an object from the supplied items.
    </summary>
    <param name="items">The source items.</param>
  </CopyConstructor>

  <!-- Collection Methods -->
  <LJCKeysPropertyNames>
    <summary>
      Gets a list of property names from the data value items.
    </summary>
    <param name="keys">The data values collection.</param>
    <returns>A list of property names.</returns>
  </LJCKeysPropertyNames>
  <LJCColumnsPropertyNames>
    <summary>
      Gets a list of property names from the data column items.
    </summary>
    <param name="dataColumns">The data columns collection.</param>
    <returns>A list of property names.</returns>
  </LJCColumnsPropertyNames>

  <!-- Collection Data Methods -->
  <LJCGetUnique>
    <summary>
      Returns the row that matches the key columns.
    </summary>
    <param name="keys">The data value key items.</param>
    <returns>The matching row item.</returns>
  </LJCGetUnique>
  <LJCSort>
    <summary>
      Sorts on the key columns.
    </summary>
    <param name="keys">The data value key items.</param>
  </LJCSort>

  <!-- Custom Data Methods -->
  <LJCBinarySearch>
    <summary>
      Dynamic binary search with key columns.
    </summary>
    <param name="keys">The data column key values.</param>
    <returns>The matching item index.</returns>
  </LJCBinarySearch>
  <LJCCompareColumn>
    <summary>
      Compare column value to key column value.
    </summary>
    <param name="columnValue"></param>
    <param name="keyColumn"></param>
    <param name="ignoreCase"></param>
    <returns>The "Compare" value.</returns>
  </LJCCompareColumn>
</members>
