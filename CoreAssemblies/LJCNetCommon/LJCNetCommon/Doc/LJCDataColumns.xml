<!-- DbColumns.xml -->
<members>
  <!-- Class -->
  <LJCDataColumns>
    <summary>
      Represents a collection of
      &lt;span class="userType"&gt;LJCDataColumn&lt;/span&gt; objects.
    </summary>
    <remarks>
      A DataColumn collection element can be retrieved by name using the
      collection object: dataColumns["ColumnName"];
    </remarks>
  </LJCDataColumns>

  <!-- Static Methods -->
  <LJCCompareColumn>
    <summary>
      Compare column value to key column value.
    </summary>
    <param name="columnValue">The column value.</param>
    <param name="keyColumn">The "compare to" key column.</param>
    <param name="ignoreCase">Indicates if case should be ignored.</param>
    <returns>The "Compare" value.</returns>
  </LJCCompareColumn>
  <LJCDeserialize>
    <summary>
      Deserializes from the specified XML file.
    </summary>
    <param name="fileSpec">The XML file specification.</param>
    <returns>The LJCDataColumns collection.</returns>
  </LJCDeserialize>
  <LJCObjectColumns>
    <summary>
      Gets a collection of items from a data object.
    </summary>
    <param name="dataObject">The data object value.</param>
    <param name="dataDefinition">The data definitions.</param>
    <returns>The LJCDataColumns collection.</returns>
  </LJCObjectColumns>
  <LJCObjectColumnsInList>
    <summary>
      Gets a collection of items from a data object that match the supplied
      property Names.
    </summary>
    <param name="dataObject">The data object value.</param>
    <param name="propertyNames">The property names list.</param>
    <returns>The LJCDataColumns collection.</returns>
  </LJCObjectColumnsInList>
  <LJCObjectPropertyNames>
    <summary>
      Gets a list of property names from a data object.
    </summary>
    <param name="dataObject">The data object value.</param>
    <returns>The property names list.</returns>
  </LJCObjectPropertyNames>
  <LJCSearchColumns>
    <summary>
      Custom binary search for Name value.
    </summary>
    <typeparam name="T">The type value.</typeparam>
    <param name="list">The search list.</param>
    <param name="keyColumns">The search key values.</param>
    <returns>The matching item index.</returns>
  </LJCSearchColumns>
  <ToDataValues>
    <summary>
      Operator to create
      &lt;span class="userType"&gt;LJCDataValues&lt;/span&gt;
      from
      &lt;span class="userType"&gt;LJCDataColumns&lt;/span&gt;.
    </summary>
    <param name="dataColumns">
      The &lt;span class="userType"&gt;LJCDataColumns&lt;/span&gt;
      object.
    </param>
    <example>
      <code xml:space="preserve">
        using LJCNetCommon;

        LJCDataColumns dataColumns = new LJCDataColumns();
        dataColumns.Add("Column1");
        dataColumns.Add("Column2");

        var dataValues = dataColumns;
      </code>
    </example>
  </ToDataValues>

  <!-- Properties -->
  <LJCDefaultFileName>
    <summary>
      Gets the Default File Name.
    </summary>
  </LJCDefaultFileName>
  <LJCKeys>
    <summary>
      Gets or sets the key columns.
    </summary>
  </LJCKeys>
  <Item>
    <summary>
      Gets the item with the supplied property name.
    </summary>
    <param name="propertyName">The column property name.</param>
    <returns>The selected DbColumn object.</returns>
  </Item>

  <!-- Constructor Methods -->
  <Constructor>
    <summary>
      Initializes an object instance.
    </summary>
  </Constructor>
  <CopyConstructor>
    <summary>
      Initializes an object from the supplied items.
    </summary>
    <param name="items">The source list.</param>
  </CopyConstructor>

  <!-- Collection Methods -->
  <Clone>
    <summary>
      Creates and returns a clone of the object.
    </summary>
    <returns>The cloned object.</returns>
  </Clone>
  <HasItems>
    <summary>
      Checks if the collection has items.
    </summary>
    <returns>true if there are items; otherwise, false.</returns>
  </HasItems>
  <LJCColumns>
    <summary>
      Returns a collection of columns that match the supplied property names.
    </summary>
    <param name="propertyNames">The column property names.</param>
    <returns>The created object.</returns>
  </LJCColumns>
  <LJCKeysPropertyNames>
    <summary>
      Gets a list of property names from the data value items.
    </summary>
    <param name="keys">The data values collection.</param>
    <returns>A list of property names.</returns>
  </LJCKeysPropertyNames>
  <LJCColumnsPropertyNames>
    <summary>
      Gets a list of property names from the data column items.
    </summary>
    <param name="dataColumns">The data columns collection.</param>
    <returns>A list of property names.</returns>
  </LJCColumnsPropertyNames>
  <LJCSerialize>
    <summary>
      Serializes the collection
    </summary>
    <param name="fileSpec">The output XML file.</param>
  </LJCSerialize>
  
  <!-- Collection Data Methods -->
  <Add1>
    <summary>
      Adds the object element to the collection
    </summary>
    <param name="dataColumn">The object element.</param>
    <remarks>Overrides the base Add method.</remarks>
  </Add1>
  <Add2>
    <summary>
      Creates the Object from the arguments and adds it to the collection.
    </summary>
    <param name="propertyName">The property name.</param>
    <param name="position">The column layout position.</param>
    <param name="maxLength">The column length.</param>
    <returns>
      The created
      &lt;span class="userType"&gt;DbColumn&lt;/span&gt; object.
    </returns>
    <remarks>
      This method is useful for data sources that require a column position value.
      An example would be a text file that uses fixed length fields.
    </remarks>
  </Add2>
  <Add3>
    <summary>
      Creates the Object from the arguments and adds it to the collection.
    </summary>
    <param name="propertyName">The property name.</param>
    <param name="value">The value object.</param>
    <param name="dataTypeName">The data type name.</param>
    <param name="maxLength">The column length.</param>
    <param name="caption">The column length.</param>
    <returns>The created DbColumn object.</returns>
    <example>
      <code xml:space="preserve">
        using LJCNetCommon;

        var dbColumns = new DbColumns();

        // Must use (object) with a string value to execute this constructor.
        dbColumns.Add("ColumnName", (object)"Value");
      </code>
    </example>
  </Add3>
  <LJCGetUnique>
    <summary>
      Gets the column that matches the key columns.
    </summary>
    <param name="keys">The LJCDataValue keys.</param>
    <returns>The matching item object.</returns>
  </LJCGetUnique>
  <LJCRemove>
    <summary>
      Removes a grid column.
    </summary>
    <param name="propertyName">The property name.</param>
  </LJCRemove>
  <LJCSetData>
    <summary>
      Add or Update.
    </summary>
    <param name="dataColumn">The source object.</param>
  </LJCSetData>
  <LJCSort>
    <summary>
      Sorts on the current key columns.
    </summary>
    <param name="keys">The LJCDataValue keys.</param>
  </LJCSort>

  <!-- Changes Methods -->
  <LJCChanged>
    <summary>
      Gets a collection of changed columns.
    </summary>
    <returns>The changed columns collection.</returns>
  </LJCChanged>
  <LJCClearChanged>
    <summary>
      Sets the IsChanged value to false for all elements in the collection.
    </summary>
  </LJCClearChanged>

  <!-- Other Methods -->
  <LJCSetCaptions>
    <summary>
      Sets the caption properties.
    </summary>
    <param name="dataColumns">The target object.</param>
  </LJCSetCaptions>
  <LJCMapNames>
    <summary>
      Maps the column property and rename values.
    </summary>
    <param name="columnName">The Column name.</param>
    <param name="propertyName">The Property name.</param>
    <param name="renameAs">The Rename value.</param>
    <param name="caption">The Caption value.</param>
  </LJCMapNames>

  <!-- Value Methods -->
  <LJCBoolean>
    <summary>
      Gets the column object value as a bool.
    </summary>
    <param name="propertyName">The property name.</param>
    <returns>The bool value.</returns>
  </LJCBoolean>
  <LJCByte>
    <summary>
      Gets the column object value as a byte.
    </summary>
    <param name="propertyName">The property name.</param>
    <returns>The byte value.</returns>
  </LJCByte>
  <LJCBytes>
    <summary>
      Gets the column object value as a byte array.
    </summary>
    <param name="propertyName">The property name.</param>
    <returns>The byte array.</returns>
  </LJCBytes>
  <LJCChar>
    <summary>
      Gets the column object value as a char.
    </summary>
    <param name="propertyName">The property name.</param>
    <returns>The char value.</returns>
  </LJCChar>
  <LJCChars>
    <summary>
      Gets the column object value as a char array.
    </summary>
    <param name="propertyName">The property name.</param>
    <returns>The char array.</returns>
  </LJCChars>
  <LJCDateTime>
    <summary>
      Gets the column object value as a
      &lt;span class="userType"&gt;DateTime&lt;/span&gt;.
    </summary>
    <param name="propertyName">The property name.</param>
    <returns>The DateTime value.</returns>
  </LJCDateTime>
  <LJCDecimal>
    <summary>
      Gets the column object value as a
      &lt;span class="userType"&gt;decimal&lt;/span&gt;
      value.
    </summary>
    <param name="propertyName">The property name.</param>
    <returns>
      The &lt;span class="userType"&gt;Decimal&lt;/span&gt; value.
    </returns>
  </LJCDecimal>
  <LJCDouble>
    <summary>
      Gets the column object value as a double.
    </summary>
    <param name="propertyName">The property name.</param>
    <returns>The double value.</returns>
  </LJCDouble>
  <LJCFloat>
    <summary>
      Gets the column object value as a float.
    </summary>
    <param name="propertyName">The property name.</param>
    <returns>The float value.</returns>
  </LJCFloat>
  <LJCGuid>
    <summary>
      Gets the column object value as a GUID.
    </summary>
    <param name="propertyName">The property name.</param>
    <returns>The Guid value.</returns>
  </LJCGuid>
  <LJCInt16>
    <summary>
      Gets the column object value as a
      &lt;span class="userType"&gt;short&lt;/span&gt; int.
    </summary>
    <param name="propertyName">The property name.</param>
    <returns>
      The
      &lt;span class="userType"&gt;short&lt;/span&gt;
      int value.
    </returns>
  </LJCInt16>
  <LJCInt32>
    <summary>
      Gets the column object value as an
      &lt;span class="userType"&gt;int&lt;/span&gt;.
    </summary>
    <param name="propertyName">The property name.</param>
    <returns>
      The &lt;span class="userType"&gt;int&lt;/span&gt;
      value.
    </returns>
  </LJCInt32>
  <LJCInt64>
    <summary>
      Gets the column object value as a
      &lt;span class="userType"&gt;long&lt;/span&gt; int.
    </summary>
    <param name="propertyName">The property name.</param>
    <returns>
      The &lt;span class="userType"&gt;long&lt;/span&gt;
      int value.
    </returns>
  </LJCInt64>
  <LJCString>
    <summary>
      Gets the column object value as a string.
    </summary>
    <param name="propertyName">The property name.</param>
    <returns>The string value.</returns>
  </LJCString>
  <LJCValue>
    <summary>
      Gets the column object value as an object.
    </summary>
    <param name="propertyName">The property name.</param>
    <returns>The object value.</returns>
  </LJCValue>

  <!-- Other Value Methods -->
  <LJCDbDateString>
    <summary>
      Gets a database DateTime string.
    </summary>
    <param name="propertyName">The property name.</param>
    <returns>The database format date string.</returns>
  </LJCDbDateString>
  <LJCDbDateTime>
    <summary>
      Gets the column object value as a DateTime.
    </summary>
    <param name="propertyName">The property name.</param>
    <returns>The DateTime value.</returns>
  </LJCDbDateTime>
  <LJCSetValue>
    <summary>
      Sets the value for the column with the specified name.
    </summary>
    <param name="propertyName">The property name.</param>
    <param name="value">The column value.</param>
  </LJCSetValue>
</members>
