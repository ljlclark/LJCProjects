<!-- KeyItems.xml -->
<members>
  <!-- Class -->
  <LJCKeyItems>
    <summary>
      Represents a collection of
      &lt;span class="userType"&gt;KeyItem&lt;/span&gt; objects.
    </summary>
  </LJCKeyItems>
  
  <!-- Static Methods -->
  <GetCollection>
    <summary>
      Get custom collection from List&lt;T&gt;.
    </summary>
    <param name="items">The Items collection.</param>
    <returns>The collection object reference.</returns>
  </GetCollection>
  <HasItems>
    <summary>
      Checks if the collection has items.
    </summary>
    <param name="collection">The collection object.</param>
    <returns>true if there are items; otherwise, false.</returns>
  </HasItems>
  
  <!-- Properties -->
  <Count>
    <summary>
      The Collection count.
    </summary>
    <returns>The items count.</returns>
  </Count>
  <Items>
    <summary>
      The LJCKeyItem items.
    </summary>
    <returns>The items collection.</returns>
  </Items>
  <Indexer>
    <summary>
      Gets the item by index value.
    </summary>
    <param name="index">The index value.</param>
    <returns>The element item object.</returns>
  </Indexer>

  <!-- Constructor Methods -->
  <Constructor>
    <summary>
      Initializes an object instance.
    </summary>
  </Constructor>
  <CopyConstructor>
    <summary>
      The Copy constructor.
    </summary>
    <param name="items">The source collection.</param>
  </CopyConstructor>

  <!-- Collection Methods -->
  <Clone>
    <summary>
      Creates and returns a clone of the object.
    </summary>
    <returns>The cloned object.</returns>
  </Clone>
  <HasItems2>
    <summary>
      Checks if the collection has items.
    </summary>
    <returns>true if there are items; otherwise, false.</returns>
  </HasItems2>
  
  <!-- Collection Data Methods -->
  <Add1>
    <summary>
      Adds the specified object.
    </summary>
    <param name="item">The item object.</param>
    <remarks>Overrides the base Add method.</remarks>
  </Add1>
  <Add2>
    <summary>
      Creates and adds the object with the provided values.
    </summary>
    <param name="propertyName">The Property Name.</param>
    <param name="id">The ID value.</param>
    <param name="description">The Description.</param>
    <param name="maxLength">The MaxLength value.</param>"
    <returns>The created key item object.</returns>
  </Add2>
  <Append>
    <summary>
      Appends the supplied objects to the collection.
    </summary>
    <param name="items">The collection to be appended.</param>
  </Append>
  <LJCRetrieve>
    <summary>
      Retrieves an item by property name.
    </summary>
    <param name="propertyName">The property name.</param>
    <returns>The matching item object.</returns>
  </LJCRetrieve>

  <!-- Other Methods -->
  <GetDescription>
    <summary>
      Gets the Item Description with Value as index within PropertyName.
    </summary>
    <param name="dataColumn">The DataColumn object.</param>
    <returns>The Item Description.</returns>
  </GetDescription>
  <GetIndex>
    <summary>
      Get index from Value.
    </summary>
    <param name="dataColumn">The DataColumn object.</param>
    <returns>The item index.</returns>
  </GetIndex>
  <GetItem>
    <summary>
      Gets the KeyItem with Value as index within PropertyName.
    </summary>
    <param name="dataColumn">The DataColumn object.</param>
    <returns>The selected ControlItem.</returns>
  </GetItem>
  <GetItems>
    <summary>
      Gets the Items with the PropertyName.
    </summary>
    <param name="dataColumn">The DataColumn object.</param>
    <returns>The valid ControlItems.</returns>
  </GetItems>

  <!-- Search and Sort Methods -->
  <SearchPropertyName>
    <summary>
      Retrieve the collection element.
    </summary>
    <param name="name">The property name.</param>
    <returns>The matching item object.</returns>
  </SearchPropertyName>
  <SortPropertyName>
    <summary>
      Sort on Name.
    </summary>
  </SortPropertyName>
  
  <!-- IEnumerable Methods -->
  <GetEnumerator>
    <summary>
      Gets the Collection Enumerator.
    </summary>
    <returns>The Collection Enumerator.</returns>
  </GetEnumerator>
</members>