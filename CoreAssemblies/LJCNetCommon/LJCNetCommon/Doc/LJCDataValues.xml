<!-- LJCDataValues.xml -->
<members>
  <!-- Class -->
  <LJCDataValues>
    <summary>
      Represents a collection of
      &lt;span class="userType"&gt;LJCDataValue&lt;/span&gt; objects.
    </summary>
    <remarks>
      A LJCDataValues collection element can also be retrieved by name using
      the collection object: values["PropertyName"];
    </remarks>
  </LJCDataValues>
  
  <!-- Static Methods -->
  <LJCDeserialize>
    <summary>
      Deserializes from the specified XML file.
    </summary>
    <param name="fileSpec">The XML file name.</param>
  </LJCDeserialize>
  <ToDataColumns>
    <summary>
      Operator to create LJCDataColumns from LJCDataValues.
    </summary>
    <param name="dataValues">The data values collection.</param>
    <returns>The data columns collection.</returns>
  </ToDataColumns>

  <!-- Properties -->
  <LJCDefaultFileName>
    <summary>
      Gets the Default File Name.
    </summary>
  </LJCDefaultFileName>
  <LJCKeys>
    <summary>
      Gets or sets the key columns.
    </summary>
  </LJCKeys>
  <Item>
    <summary>
      The column for the specified property name.
    </summary>
    <param name="propertyName">The property name.</param>
    <returns>The selected data value object.</returns>
  </Item>

  <!-- Constructor Methods -->
  <Constructor>
    <summary>
      Initializes an object instance.
    </summary>
  </Constructor>
  <CopyConstructor>
    <summary>
      The Copy constructor.
    </summary>
    <param name="items">The source items.</param>
  </CopyConstructor>
  
  <!-- Collection Methods -->
  <Clone>
    <summary>
      Creates and returns a clone of the object.
    </summary>
  </Clone>
  <HasItems>
    <summary>
      Checks if the collection has items.
    </summary>
    <returns>true if there are items; otherwise, false.</returns>
  </HasItems>
  <LJCChanged>
    <summary>
      Gets a collection of changed columns.
    </summary>
    <returns>The changed values collection.</returns>
  </LJCChanged>
  <LJCClearChanged>
    <summary>
      Sets the IsChanged value to false for all elements in the collection.
    </summary>
  </LJCClearChanged>
  <LJCCreateColumns>
    <summary>
      Creates combined
      &lt;span class="userType"&gt;DataColumns&lt;/span&gt; from
      &lt;span class="userType"&gt;DataColumns&lt;/span&gt; and
      &lt;span class="userType"&gt;DataValues&lt;/span&gt;.
    </summary>
    <param name="dataColumns">The column definitions.</param>
    <returns>
      The combined
      &lt;span class="userType"&gt;DbColumns&lt;/span&gt; object.
    </returns>
  </LJCCreateColumns>
  <LJCKeyPropertyNames>
    <summary>
      Gets a list of property names from the collection items.
    </summary>
    <param name="keys">The data values collection.</param>
    <returns>A list of property names.</returns>
  </LJCKeyPropertyNames>
  <LJCPropertyNames>
    <summary>
      Gets a list of property names from the collection items.
    </summary>
    <param name="dataValues">The data values collection.</param>
    <returns>A list of property names.</returns>
  </LJCPropertyNames>
  <LJCSerialize>
    <summary>
      Serializes the collection
    </summary>
    <param name="fileSpec">The XML file name.</param>
  </LJCSerialize>
  
  <!-- Collection Data Methods -->
  <Add>
    <summary>
      Creates the Object from the arguments and adds it to the collection.
    </summary>
    <param name="propertyName">The PropertyName value.</param>
    <param name="value">The item value.</param>
    <param name="dataTypeName">The DataType name.</param>
    <returns>A reference to the added item.</returns>
  </Add>
  <LJCGetUnique>
    <summary>
      Returns the value that matches the key columns.
    </summary>
    <param name="keys">The LJCDataValue keys.</param>
    <returns>The matching item object.</returns>
  </LJCGetUnique>
  <Remove>
    <summary>
      Removes the item with the supplied property name.
    </summary>
    <param name="propertyName">The property name.</param>
  </Remove>
  <LJCSort>
    <summary>
      Sorts on the current key columns.
    </summary>
    <param name="keys">The LJCDataValue keys.</param>
  </LJCSort>
  
  <!-- Value Methods -->
  <LJCBoolean>
    <summary>
      Gets the column object value as a bool.
    </summary>
    <param name="propertyName">The property name.</param>
    <returns>The bool value.</returns>
  </LJCBoolean>
  <LJCByte>
    <summary>
      Gets the column object value as a byte.
    </summary>
    <param name="propertyName">The property name.</param>
    <returns>The byte value.</returns>
  </LJCByte>
  <LJCBytes>
    <summary>
      Gets the column object value as a byte array.
    </summary>
    <param name="propertyName">The property name.</param>
    <returns>The byte array.</returns>
  </LJCBytes>
  <LJCChar>
    <summary>
      Gets the column object value as a char.
    </summary>
    <param name="propertyName">The property name.</param>
    <returns>The char value.</returns>
  </LJCChar>
  <LJCChars>
    <summary>
      Gets the column object value as a char array.
    </summary>
    <param name="propertyName">The property name.</param>
    <returns>The char array.</returns>
  </LJCChars>
  <LJCDateTime>
    <summary>
      Gets the column object value as a
      &lt;span class="userType"&gt;DateTime&lt;/span&gt;.
    </summary>
    <param name="propertyName">The property name.</param>
    <returns>The DateTime value.</returns>
  </LJCDateTime>
  <LJCDecimal>
    <summary>
      Gets the column object value as a
      &lt;span class="userType"&gt;decimal&lt;/span&gt;
      value.
    </summary>
    <param name="propertyName">The property name.</param>
    <returns>
      The &lt;span class="userType"&gt;Decimal&lt;/span&gt; value.
    </returns>
  </LJCDecimal>
  <LJCDouble>
    <summary>
      Gets the column object value as a double.
    </summary>
    <param name="propertyName">The property name.</param>
    <returns>The double value.</returns>
  </LJCDouble>
  <LJCFloat>
    <summary>
      Gets the column object value as a float.
    </summary>
    <param name="propertyName">The property name.</param>
    <returns>The float value.</returns>
  </LJCFloat>
  <LJCGuid>
    <summary>
      Gets the column object value as a GUID.
    </summary>
    <param name="propertyName">The property name.</param>
    <returns>The Guid value.</returns>
  </LJCGuid>
  <LJCInt16>
    <summary>
      Gets the column object value as a
      &lt;span class="userType"&gt;short&lt;/span&gt; int.
    </summary>
    <param name="propertyName">The property name.</param>
    <returns>
      The
      &lt;span class="userType"&gt;short&lt;/span&gt;
      int value.
    </returns>
  </LJCInt16>
  <LJCInt32>
    <summary>
      Gets the column object value as an
      &lt;span class="userType"&gt;int&lt;/span&gt;.
    </summary>
    <param name="propertyName">The property name.</param>
    <returns>
      The &lt;span class="userType"&gt;int&lt;/span&gt;
      value.
    </returns>
  </LJCInt32>
  <LJCInt64>
    <summary>
      Gets the column object value as a
      &lt;span class="userType"&gt;long&lt;/span&gt; int.
    </summary>
    <param name="propertyName">The property name.</param>
    <returns>
      The &lt;span class="userType"&gt;long&lt;/span&gt;
      int value.
    </returns>
  </LJCInt64>
  <LJCString>
    <summary>
      Gets the column object value as a string.
    </summary>
    <param name="propertyName">The property name.</param>
    <returns>The string value.</returns>
  </LJCString>
  <LJCValue>
    <summary>
      Gets the column object value as an object.
    </summary>
    <param name="propertyName">The property name.</param>
    <returns>The object value.</returns>
  </LJCValue>

  <!-- Other Value Methods -->
  <LJCDbDateString>
    <summary>
      Gets a database DateTime string.
    </summary>
    <param name="propertyName">The property name.</param>
    <returns>The database format date string.</returns>
  </LJCDbDateString>
  <LJCDbDateTime>
    <summary>
      Gets the column object value as a DateTime.
    </summary>
    <param name="propertyName">The property name.</param>
    <returns>The DateTime value.</returns>
  </LJCDbDateTime>
  <LJCSetValue>
    <summary>
      Sets the object value for the column with the specified name.
    </summary>
    <param name="propertyName">The property name.</param>
    <param name="value">The string value.</param>
  </LJCSetValue>
</members>